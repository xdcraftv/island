<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Island – notch prototype</title>
<style>
:root{--bg:#f3f4f7;--fg:#14161a;--muted:#5b6270;--card:#fff;--line:#d5d9e0;--accent:#2f6df6;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d0f13;--fg:#eceef2;--muted:#9aa1ad;--card:#171a20;--line:#2a2e37;--accent:#7aa5ff}}
:root[data-theme="dark"]{--bg:#0d0f13;--fg:#eceef2;--muted:#9aa1ad;--card:#171a20;--line:#2a2e37;--accent:#7aa5ff}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 "Segoe UI Variable","Segoe UI",system-ui,sans-serif}
.wrap{max-width:900px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:22px;margin:0 0 4px;letter-spacing:-.01em}
p.lead{margin:0 0 16px;color:var(--muted)}
.stage{position:relative;height:430px;border-radius:16px;overflow:hidden;
background:radial-gradient(600px 300px at 20% 90%,#2bb3a3 0,transparent 70%),radial-gradient(500px 300px at 90% 70%,#e0709a 0,transparent 70%),linear-gradient(140deg,#2c2a6e,#1d6fa5)}
.hint{position:absolute;left:0;right:0;bottom:22px;text-align:center;color:#fff;opacity:.85;font-size:14px;padding:0 16px}
/* the notch */
@property --glow{syntax:"<color>";inherits:true;initial-value:transparent}
.notch{--glow:transparent;--tint:#e5252f;position:absolute;top:0;left:50%;transform:translateX(-50%);width:176px;height:32px;background:radial-gradient(120% 120% at 50% 135%,var(--glow) 0,transparent 70%),#000;color:#fff;
border-radius:0 0 18px 18px;box-shadow:0 0 0 #0000;transition:width .38s cubic-bezier(.4,0,.2,1),height .38s cubic-bezier(.4,0,.2,1),border-radius .4s,box-shadow .4s,--glow .8s ease;cursor:default;user-select:none}
.notch::before,.notch::after{content:"";position:absolute;top:0;width:14px;height:14px}
.notch::before{right:100%;background:radial-gradient(circle at 0 100%,transparent 13.5px,#000 14px)}
.notch::after{left:100%;background:radial-gradient(circle at 100% 100%,transparent 13.5px,#000 14px)}
.notch[data-state=peek]{width:300px;height:48px}
.notch[data-state=peek],.notch[data-state=open]{transition:width .6s cubic-bezier(.34,1.45,.45,1),height .6s cubic-bezier(.34,1.45,.45,1),border-radius .4s,box-shadow .4s,--glow .8s ease}
.notch[data-state=open][data-tab=music]{--glow:var(--tint)}
.notch[data-state=open]{width:min(520px,calc(100% - 48px));height:200px;border-radius:0 0 28px 28px;box-shadow:0 16px 36px #0007}
.body{position:absolute;inset:0;overflow:hidden;border-radius:inherit}
.view{position:absolute;inset:0;opacity:0;pointer-events:none;transform:scale(.94);transform-origin:50% 0;filter:blur(5px);transition:opacity .18s,transform .18s,filter .18s}
[data-state=idle] .v-idle,[data-state=peek] .v-peek{opacity:1;transform:none;filter:none;transition:opacity .35s .12s,transform .5s cubic-bezier(.2,.9,.3,1.2) .1s,filter .3s .1s}
[data-state=open] .v-open{opacity:1;pointer-events:auto;transform:none;filter:none;transition:opacity .35s .16s,transform .5s cubic-bezier(.2,.9,.3,1.2) .14s,filter .3s .14s}
.v-idle{display:flex;align-items:center;justify-content:space-between;padding:0 16px}
.ring{width:12px;height:12px;border-radius:50%;--p:360deg;background:conic-gradient(#34d27b var(--p),#2a2f2c 0);-webkit-mask:radial-gradient(circle,transparent 3.2px,#000 3.7px);mask:radial-gradient(circle,transparent 3.2px,#000 3.7px)}
.clock{font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}
.bars{display:flex;gap:2px;align-items:center;height:12px}
.bars i{width:2px;height:4px;background:#fff;border-radius:1px}
.playing .bars i{animation:eq .9s ease-in-out infinite}
.bars i:nth-child(2){animation-delay:.2s!important}.bars i:nth-child(3){animation-delay:.4s!important}
@keyframes eq{50%{height:12px}}
.v-peek{display:flex;align-items:center;gap:12px;padding:0 18px}
.v-peek svg{width:20px;height:20px;fill:#fff;flex:none}
.v-peek b{display:block;font-size:13px;line-height:1.2}.v-peek small{color:#9aa0a8;font-size:11px}
.meter{margin-left:auto;width:64px;height:5px;border-radius:3px;background:#333;overflow:hidden}
.meter i{display:block;height:100%;background:#fff;border-radius:3px;transition:width .7s cubic-bezier(.2,.9,.3,1)}
.v-open{padding:10px 18px 14px;display:flex;flex-direction:column}
.tabs{display:flex;gap:4px;justify-content:center;margin-bottom:8px}
.tab{background:none;border:0;color:#9aa0a8;font:600 12px inherit;font-family:inherit;padding:4px 12px;border-radius:99px;cursor:pointer}
.tab.on{background:#262626;color:#fff}
.tab:focus-visible,.ib:focus-visible,.btn:focus-visible,.chip button:focus-visible{outline:2px solid #7aa5ff;outline-offset:2px}
.pane{flex:1;min-height:0}.pane[hidden]{display:none}
.row{display:flex;gap:12px;align-items:center}
.art{width:54px;height:54px;border-radius:10px;flex:none;background:linear-gradient(135deg,#f6b73c,#e0457b 55%,#5b3fd6)}
.meta{min-width:0;flex:1}.meta b,.meta small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta b{font-size:14px}.meta small{color:#9aa0a8;font-size:12px}
.ctl{display:flex;gap:2px}
.ib{background:none;border:0;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;display:grid;place-items:center}
.ib:hover{background:#ffffff22}.ib svg{width:18px;height:18px;fill:#fff}
.scrub{display:flex;gap:8px;align-items:center;font-size:11px;color:#9aa0a8;margin-top:6px;font-variant-numeric:tabular-nums}
input[type=range]{flex:1;-webkit-appearance:none;appearance:none;height:4px;border-radius:2px;background:#ffffff33;outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:10px;height:10px;border-radius:50%;background:#fff}
input[type=range]::-moz-range-thumb{width:10px;height:10px;border:0;border-radius:50%;background:#fff}
.big{font-size:38px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.02em;line-height:1}
.btn{background:#262626;color:#fff;border:0;border-radius:99px;padding:7px 16px;font:600 13px inherit;font-family:inherit;cursor:pointer}
.btn.go{background:#fff;color:#000}.btn:hover{filter:brightness(1.2)}
.pbar{height:4px;border-radius:2px;background:#ffffff26;margin-top:12px;overflow:hidden}.pbar i{display:block;height:100%;width:0;background:#34d27b}
.drop{height:100%;border:1.5px dashed #444;border-radius:14px;padding:8px;display:flex;flex-wrap:wrap;gap:6px;align-content:flex-start;overflow:auto;color:#9aa0a8;font-size:13px}
.notch.dropping .drop{border-color:#7aa5ff;background:#7aa5ff14}
.drop .empty{margin:auto}
.chip{display:flex;align-items:center;gap:4px;background:#262626;color:#fff;border-radius:8px;padding:3px 4px 3px 9px;font-size:12px;max-width:150px}
.chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip button{background:none;border:0;color:#9aa0a8;cursor:pointer;font-size:14px;line-height:1;padding:2px 4px}
.todo{display:flex;flex-direction:column;height:100%;gap:6px}
.add{display:flex;gap:6px}
.add input{flex:1;min-width:0;background:#1c1c1c;border:1px solid #333;border-radius:99px;color:#fff;padding:6px 12px;font:inherit;font-size:13px;outline:none;user-select:text;-webkit-user-select:text}
.add input:focus{border-color:#7aa5ff}
.add .btn{padding:6px 14px}
.tl{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:2px}
.ti{display:flex;align-items:center;gap:8px;font-size:13px;padding:2px}
.ck{width:16px;height:16px;border-radius:50%;border:1.5px solid #777;background:none;flex:none;cursor:pointer;padding:0;display:grid;place-items:center}
.ti.done .ck{background:#34d27b;border-color:#34d27b}
.ck::after{content:"";width:4px;height:7px;border:solid #000;border-width:0 1.5px 1.5px 0;transform:rotate(45deg) translate(-1px,-1px) scale(0);transition:transform .3s cubic-bezier(.34,1.56,.64,1)}
.ti.done .ck::after{transform:rotate(45deg) translate(-1px,-1px) scale(1)}
.ti span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ti.done span{color:#7d828b;text-decoration:line-through}
.ti .x{background:none;border:0;color:#7d828b;cursor:pointer;font-size:15px;line-height:1;padding:2px 6px}
.ck:focus-visible,.ti .x:focus-visible,.add input:focus-visible{outline:2px solid #7aa5ff;outline-offset:2px}
.tl .empty{color:#7d828b;font-size:12px;text-align:center;margin:auto}
.dur{display:flex;align-items:center;gap:5px;margin-top:8px}
.pill{background:#262626;color:#fff;border:0;border-radius:99px;padding:4px 11px;font-weight:600;font-size:12px;font-family:inherit;cursor:pointer;transition:background .25s,color .25s,transform .18s cubic-bezier(.34,1.56,.64,1)}
.pill:active{transform:scale(.92)}.pill.on{background:#fff;color:#000}
.pill:disabled,.dur input:disabled,.ib.sm:disabled{opacity:.4;cursor:not-allowed}
.step{margin-left:auto;display:flex;align-items:center;gap:2px}
.step small{color:#9aa0a8;font-size:11px;margin-left:3px}
.ib.sm{width:24px;height:24px;font-size:16px;line-height:1}
.dur input{width:40px;text-align:center;background:#1c1c1c;border:1px solid #333;border-radius:8px;color:#fff;font-weight:600;font-size:13px;font-family:inherit;padding:3px 0;outline:none;-moz-appearance:textfield;user-select:text;-webkit-user-select:text}
.dur input::-webkit-outer-spin-button,.dur input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.dur input:focus-visible,.pill:focus-visible{outline:2px solid #7aa5ff;outline-offset:2px}
.pray{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}
.pt{text-align:center;padding:7px 0;border-radius:10px}
.pt small{display:block;color:#9aa0a8;font-size:11px}.pt b{font-size:14px;font-variant-numeric:tabular-nums}
.pt.on{background:#ffffff1f}.pt.on small{color:#fff}
.pnext{text-align:center;color:#9aa0a8;font-size:12px;margin-top:8px}
.sim{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center}
.sim span{color:var(--muted);font-size:13px;margin-right:4px}
.sim button{background:var(--card);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:8px 14px;font:inherit;font-size:13px;cursor:pointer}
.sim button:hover{border-color:var(--accent)}.sim button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.note{color:var(--muted);font-size:13px;margin-top:18px;max-width:64ch}
@keyframes up{from{opacity:0;transform:translateY(8px)}}
@keyframes pop{from{opacity:0;transform:scale(.3) rotate(-25deg)}}
@keyframes artIn{from{opacity:.2;transform:scale(.8) rotate(-6deg)}}
@keyframes rowIn{from{opacity:0;transform:translateY(-8px) scale(.96)}}
.v-open .tabs,.v-open .pane{opacity:0;transform:translateY(-8px);transition:opacity .15s,transform .15s}
[data-state=open] .v-open .tabs{opacity:1;transform:none;transition:opacity .4s .22s,transform .55s cubic-bezier(.2,.9,.3,1.2) .2s}
[data-state=open] .v-open .pane{opacity:1;transform:none;transition:opacity .4s .3s,transform .55s cubic-bezier(.2,.9,.3,1.2) .28s}
.pane>*{animation:up .45s cubic-bezier(.2,.9,.3,1) both}.pane>:nth-child(2){animation-delay:.06s}
.v-peek svg{animation:pop .55s cubic-bezier(.34,1.56,.64,1) .12s both}.v-peek>div:not(.meter){animation:up .4s .16s both}
.art.swap{animation:artIn .5s cubic-bezier(.34,1.56,.64,1)}
.tab,.ib,.btn,.ck,.pt{transition:background .25s,color .25s,border-color .2s,transform .18s cubic-bezier(.34,1.56,.64,1)}
.tab:active,.ib:active,.btn:active{transform:scale(.9)}
.ti{transition:opacity .22s,transform .22s}.ti.new{animation:rowIn .4s cubic-bezier(.34,1.56,.64,1)}.ti.out{opacity:0;transform:translateX(14px)}
.ti span{transition:color .3s}
@media (max-width:420px){.tab{padding:4px 7px}}
@media (prefers-reduced-motion:reduce){.notch,.view,.v-open .tabs,.v-open .pane{transition-duration:.01s!important;transition-delay:0s!important}.playing .bars i,.pane>*,.v-peek svg,.v-peek>div,.ti.new,.art.swap{animation:none!important}}
.wxi{display:grid;place-items:center;width:16px;height:16px}
.tabs{overflow-x:auto;scrollbar-width:none;justify-content:flex-start}.tabs::-webkit-scrollbar{display:none}
.tabs>:first-child{margin-left:auto}.tabs>:last-child{margin-right:auto}.tab{flex:none;padding:4px 10px}
.wx{display:flex;align-items:center;gap:12px}.wx .big{font-size:30px}.wx small{color:#9aa0a8;font-size:11px}
.fc{display:flex;gap:8px;margin-left:auto}.fc>div{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10px;color:#9aa0a8}
.sr{display:grid;grid-template-columns:48px 1fr 84px;gap:8px;align-items:center;font-size:12px;margin-bottom:8px}
.sr span:last-child{text-align:right;font-variant-numeric:tabular-nums;color:#9aa0a8}
.sr .bar{height:5px;border-radius:3px;background:#ffffff26;overflow:hidden}.sr .bar i{display:block;height:100%;background:#7aa5ff;transition:width .5s}
.cl{height:100%;overflow:auto;display:flex;flex-direction:column;gap:4px}
.ci{background:#1c1c1c;border-radius:8px;padding:5px 9px;font-size:12px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:none}
.ci:hover{background:#262626}.ci img{max-height:44px;border-radius:4px;display:block}
.empty2{color:#7d828b;font-size:12px;text-align:center;padding-top:30px}
.chip span{cursor:pointer}
.tabs{overflow:visible;justify-content:center}.tab{display:flex;align-items:center;gap:4px;padding:4px 8px}
.pane{overflow:hidden;border-radius:14px;padding:8px 10px}
.split{display:flex;gap:14px;height:100%}.col{flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;overflow:hidden}
.col+.col{border-left:1px solid #ffffff1a;padding-left:14px}
.col>.todo,.col>.drop,.col>#clipPane{flex:1;min-height:0}.split .big{font-size:32px}.col .btn{padding:6px 12px}
.step small{display:none}.pill{padding:4px 8px}
.tl,.cl,.drop{scrollbar-width:none}.tl::-webkit-scrollbar,.cl::-webkit-scrollbar,.drop::-webkit-scrollbar{display:none}
.sr{grid-template-columns:76px 1fr 90px}
.v-peek>div:not(.meter){min-width:0;overflow:hidden}.v-peek small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pane[data-t=music]{background:linear-gradient(135deg,color-mix(in srgb,var(--tint) 22%,transparent),transparent 75%)}
.pane[data-t=focus]{background:linear-gradient(135deg,#ff634724,#ffa03c0d)}
.pane[data-t=prayer]{background:linear-gradient(135deg,#34d27b24,#28a0a00d)}
.pane[data-t=shelf]{background:linear-gradient(135deg,#7aa5ff24,#7864ff0d)}
.pane[data-t=weather]{background:linear-gradient(135deg,#5ab4ff29,#ffd54a0d)}
.pane[data-t=system]{background:linear-gradient(135deg,#a078ff24,#3cdcdc0d)}
.tab{font-size:12.5px;padding:4px 7px}.tab svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pane{border-radius:16px}
.pane[data-t=music]{background:linear-gradient(160deg,color-mix(in srgb,var(--tint) 30%,transparent),color-mix(in srgb,var(--tint) 12%,transparent));border:1px solid color-mix(in srgb,var(--tint) 20%,transparent)}
.pane[data-t=focus]{background:linear-gradient(160deg,#ff634730,#c8401e1a);border:1px solid #ff634722}
.pane[data-t=prayer]{background:linear-gradient(160deg,#34d27b2e,#0f8a5a1a);border:1px solid #34d27b22}
.pane[data-t=shelf]{background:linear-gradient(160deg,#7aa5ff30,#5a46c81a);border:1px solid #7aa5ff22}
.pane[data-t=weather]{background:linear-gradient(160deg,#5ab4ff33,#ffd54a14);border:1px solid #5ab4ff22}
.pane[data-t=system]{background:linear-gradient(160deg,#a078ff30,#1eb4b41a);border:1px solid #a078ff22}
